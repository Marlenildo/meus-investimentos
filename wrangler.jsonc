{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meus-investimentos",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // O banco é criado sozinho no primeiro deploy (provisionamento automático do Wrangler 4.45+).
  // Se preferir criar à mão no painel, adicione aqui: "database_id": "<id do painel>"
  "d1_databases": [
    { "binding": "DB", "database_name": "meus-investimentos" }
  ],
  "observability": { "enabled": true }
}
